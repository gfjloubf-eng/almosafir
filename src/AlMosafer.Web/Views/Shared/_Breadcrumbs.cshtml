@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var title = ViewData["Title"]?.ToString() ?? string.Empty;
}

@if (controller != "Home" || action != "Index")
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-light p-2 rounded shadow-sm fs-7">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none font-weight-bold">الرئيسية 🏠</a></li>
            @if (controller == "Admin")
            {
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard" class="text-decoration-none">لوحة الإدارة 🛡️</a></li>
            }
            else if (controller == "Traveler")
            {
                <li class="breadcrumb-item"><a asp-controller="Traveler" asp-action="Dashboard" class="text-decoration-none">لوحة المسافر 🧳</a></li>
            }
            else if (controller == "Driver")
            {
                <li class="breadcrumb-item"><a asp-controller="Driver" asp-action="Dashboard" class="text-decoration-none">لوحة السائق 🚗</a></li>
            }
            <li class="breadcrumb-item active text-dark font-weight-bold" aria-current="page">@title</li>
        </ol>
    </nav>
}
