@model IEnumerable<AlMosafer.Application.DTOs.Payments.PaymentDetailsDto>
@{
    ViewData["Title"] = "مراقبة المعاملات المالية — نظام المسافر";
}

<div class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="font-weight-bold text-dark mb-1">مراقبة السجل المالي والمدفوعات 💳</h3>
            <p class="text-muted mb-0">عرض وحصر إيصالات وسجلات المعاملات المالية المسددة والمؤكدة</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary font-weight-bold">← العودة للوحة الإدارة</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">💳</div>
            <h4 class="font-weight-bold text-dark mb-2">لا توجد معاملات مالية مسجلة بعد</h4>
            <p class="text-muted mb-0">لم تقم المنظومة بتأكيد عمليات سداد مالية في قاعدة البيانات حتى الآن.</p>
        </div>
    }
    else
    {
        <div class="card-almosafer shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-end">
                    <thead class="bg-light">
                        <tr>
                            <th># Payment ID</th>
                            <th>رقم الحجز</th>
                            <th>المسافر</th>
                            <th>المبلغ</th>
                            <th>خط الرحلة</th>
                            <th>رقم العملية (Transaction ID)</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td><strong>#PAY-@p.PaymentId.ToString("D5")</strong></td>
                                <td>#BK-@p.BookingId.ToString("D6")</td>
                                <td class="font-weight-bold text-dark">@p.TravelerName</td>
                                <td class="text-success font-weight-bold">@p.Amount.ToString("N0") ريال</td>
                                <td>@p.TripRoute</td>
                                <td><code>@p.TransactionId</code></td>
                                <td><span class="badge bg-success">@p.Status</span></td>
                                <td>@p.CreatedAt.ToString("yyyy-MM-dd — HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
