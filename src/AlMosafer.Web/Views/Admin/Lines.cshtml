<div class="py-4">
    <h3 class="font-weight-bold text-dark mb-4"><i class="alm-ic" data-lucide="route" aria-hidden="true"></i> إدارة شبكة الخطوط الرسمية</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success font-weight-bold">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger font-weight-bold">@TempData["ErrorMessage"]</div>
    }

    <div class="card-almosafer p-4 mb-4">
        <h5 class="font-weight-bold text-dark mb-3">+ إنشاء خط جديد</h5>
        <form asp-action="CreateLine" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <input type="text" name="name" class="form-control" placeholder="اسم الخط: خط شملان — الجامعة" required />
            </div>
            <div class="col-md-3">
                <input type="text" name="city" class="form-control" placeholder="المدينة: صنعاء" required />
            </div>
            <div class="col-md-3">
                <input type="text" name="description" class="form-control" placeholder="وصف اختياري" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-emerald w-100 font-weight-bold">إنشاء الخط</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 mb-0">لا توجد خطوط بعد — ابدأ بإنشاء أول خط من النموذج أعلاه.</div>
    }
    else
    {
        <div class="table-responsive bg-white rounded shadow-sm p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th><th>الخط</th><th>المدينة</th><th>المواقف</th><th>المواعيد</th><th>الإجراءات</th>
                    </tr>
                </thead>
