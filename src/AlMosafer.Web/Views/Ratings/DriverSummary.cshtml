@model AlMosafer.Application.DTOs.Ratings.DriverRatingSummaryDto
@{
    ViewData["Title"] = $"تقييمات السائق {Model.DriverName} — منصة المسافر";
}

<div class="row justify-content-center py-4">
    <div class="col-md-9 col-lg-8">
        <div class="card-almosafer shadow-lg border-0">
            <div class="card-header-custom p-4 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-primary mb-1">سجل التقييمات والمراجعات</span>
                    <h3 class="mb-0 font-weight-bold">السائق: @Model.DriverName</h3>
                </div>
                <div class="text-end">
                    <span class="fs-4 font-weight-bold text-warning">⭐ @Model.AverageRating.ToString("0.0")</span>
                    <small class="d-block text-light">من أصل 5.0 (@Model.TotalRatingsCount تقييم)</small>
                </div>
            </div>
            <div class="card-body p-4">

                @if (!Model.RecentRatings.Any())
                {
                    <div class="empty-state-card my-4">
                        <div class="empty-state-icon">⭐</div>
                        <h4 class="font-weight-bold text-dark mb-2">لا توجد تقييمات بعد</h4>
                        <p class="text-muted mb-0">لم يتلق السائق أي تقييمات من الركاب حتى الآن.</p>
                    </div>
                }
                else
                {
                    <h5 class="font-weight-bold text-dark mb-3">آراء ومراجعات الركاب 💬</h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var r in Model.RecentRatings)
                        {
                            <div class="p-3 bg-light rounded border shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">👤</span>
                                        <strong class="text-dark">@r.TravelerName</strong>
                                        <span class="badge bg-secondary font-weight-normal">@r.FromCity ← @r.ToCity</span>
                                    </div>
                                    <div class="text-warning font-weight-bold fs-6">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= r.Value)
                                            {
                                                <span>★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted opacity-50">☆</span>
                                            }
                                        }
                                        <span class="text-dark ms-1">(@r.Value)</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(r.Comment))
                                {
                                    <p class="mb-2 text-dark bg-white p-3 rounded border-start border-3 border-primary">
                                        "@r.Comment"
                                    </p>
                                }

                                <div class="text-end">
                                    <small class="text-muted">📅 @r.CreatedAt.ToString("yyyy-MM-dd — HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="mt-4 pt-3 border-top text-start">
                    <button type="button" onclick="history.back()" class="btn btn-outline-secondary font-weight-bold">← الرجوع للصفحة السابقة</button>
                </div>
            </div>
        </div>
    </div>
</div>
