@model IEnumerable<AlMosafer.Application.DTOs.Notifications.NotificationDto>
@{
    ViewData["Title"] = "الإشعارات والتنبيهات — منصة المسافر";
}

<div class="py-3">
    <h3 class="font-weight-bold text-dark mb-4">مركز الإشعارات والتنبيهات <i class="alm-ic" data-lucide="bell" aria-hidden="true"></i></h3>

    @if (!Model.Any())
    {
        <div class="empty-state-card">
            <div class="empty-state-icon"><i class="alm-ic" data-lucide="bell" aria-hidden="true"></i></div>
            <h4 class="font-weight-bold text-dark mb-2">لا توجد إشعارات حالياً</h4>
            <p class="text-muted mb-0">ستصلك التنبيهات فور القيام بحجوزات أو نشر رحلات أو استقبال رسائل جديدة.</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm border-0 rounded-lg">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action p-3 mb-2 border rounded-lg @(item.IsRead ? "bg-white" : "bg-light border-primary")">
                    <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                        <h6 class="mb-1 font-weight-bold @(item.IsRead ? "text-dark" : "text-primary")">
                            @if (!item.IsRead)
                            {
                                <span class="badge bg-primary me-2">جديد</span>
                            }
                            @item.Title
                        </h6>
                        <small class="text-muted">@item.CreatedAt.ToString("yyyy-MM-dd — HH:mm")</small>
                    </div>
                    <p class="mb-2 text-secondary">@item.Message</p>
                    
                    @if (!item.IsRead)
                    {
                        <form asp-action="MarkAsRead" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="notificationId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">تحديد كـ مقروء ✓</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
