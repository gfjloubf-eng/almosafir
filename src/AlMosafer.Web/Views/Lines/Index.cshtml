@model IEnumerable<AlMosafer.Application.DTOs.Lines.LineSummaryDto>
@{
    ViewData["Title"] = "شبكة الخطوط الرسمية";
    var cities = ViewBag.Cities as IReadOnlyList<string> ?? new List<string>();
    var selected = ViewBag.SelectedCity as string;
}

<div class="py-4">
    <div class="text-center mb-4">
        <h3 class="font-weight-bold text-dark mb-1"><i class="alm-ic" data-lucide="route" aria-hidden="true"></i> شبكة الخطوط الرسمية</h3>
        <p class="text-muted mb-0">خطوط معتمدة بمواقف مرتبة ومواعيد أسبوعية معلنة — اختر خطك واعرف أين وأين تقف الحافلة</p>
    </div>

    @if (cities.Any())
    {
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(selected) ? "btn-primary" : "btn-outline-primary") font-weight-bold">كل المدن</a>
            @foreach (var c in cities)
            {
                <a asp-action="Index" asp-route-city="@c" class="btn btn-sm @(selected == c ? "btn-primary" : "btn-outline-primary") font-weight-bold">@c</a>
            }
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state-card">
            <div class="display-4 mb-3"><i class="alm-ic" data-lucide="route" aria-hidden="true"></i></div>
            <h5 class="font-weight-bold text-dark mb-2">لا توجد خطوط رسمية معلنة بعد@(string.IsNullOrEmpty(selected) ? "" : $" في {selected}")</h5>
            <p class="text-muted mb-3">تُدار الشبكة من إدارة المنصة. وإلى حينها: السائقون ينشرون التحركات الفعلية في «المواصلات الداخلية» وصفحة الرحلات.</p>
            <a asp-controller="Trips" asp-action="InternalLines" class="btn btn-primary font-weight-bold">المواصلات الداخلية المنشورة الآن 🚌</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var line in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-almosafer card-almosafer-hover h-100 d-flex flex-column">
                        <div class="card-header-custom d-flex justify-content-between align-items-center" style="background-color: var(--color-primary);">
                            <span class="font-weight-bold"><i class="alm-ic" data-lucide="route" aria-hidden="true"></i> @line.Name</span>
                            <span class="badge bg-light text-dark">@line.City</span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            <p class="mb-1 text-dark">🚏 <strong>@line.StopsCount</strong> مواقف مرتبة</p>
                            <p class="mb-3 text-muted">🗓️ <strong>@line.SchedulesCount</strong> مواعيد أسبوعية معلنة</p>
                            <div class="mt-auto d-flex justify-content-end">
                                <a asp-action="Details" asp-route-id="@line.Id" class="btn btn-accent btn-sm font-weight-bold">المواقف والمواعيد 🗺️</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
