@model IEnumerable<AlMosafer.Application.DTOs.Messaging.ConversationDto>
@{
    ViewData["Title"] = "المحادثات والرسائل — منصة المسافر";
}

<div class="py-3">
    <h3 class="font-weight-bold text-dark mb-4">المحادثات والرسائل المباشرة <i class="alm-ic" data-lucide="messages-square" aria-hidden="true"></i></h3>

    @if (!Model.Any())
    {
        <div class="empty-state-card">
            <div class="empty-state-icon"><i class="alm-ic" data-lucide="messages-square" aria-hidden="true"></i></div>
            <h4 class="font-weight-bold text-dark mb-2">لا توجد محادثات نشطة بعد</h4>
            <p class="text-muted mb-0">تنشأ غرف المحادثات المباشرة تلقائياً بين السائق والراكب بمجرد تأكيد حجز مقعد الرحلة.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model)
            {
                <div class="col-md-6">
                    <div class="card-almosafer card-almosafer-hover p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="font-weight-bold text-primary mb-0">👤 @c.OtherUserName <small class="text-muted">(@c.OtherUserRole)</small></h5>
                            <span class="badge bg-secondary">رحلة: @c.TripRoute</span>
                        </div>
                        <p class="text-muted mb-3 flex-grow-1">
                            <i class="alm-ic" data-lucide="messages-square" aria-hidden="true"></i> <strong>آخر رسالة:</strong> @(string.IsNullOrEmpty(c.LastMessage) ? "لا توجد رسائل سابقة" : c.LastMessage)
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <small class="text-muted">📅 @c.LastMessageAt.ToString("yyyy-MM-dd HH:mm")</small>
                            <a asp-action="Details" asp-route-id="@c.ConversationId" class="btn btn-accent btn-sm font-weight-bold">فتح المحادثة <i class="alm-ic" data-lucide="messages-square" aria-hidden="true"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
