@model AlMosafer.Application.DTOs.Messaging.SendMessageDto
@{
    var conversation = ViewData["Conversation"] as AlMosafer.Application.DTOs.Messaging.ConversationDto;
    var messages = ViewData["Messages"] as IEnumerable<AlMosafer.Application.DTOs.Messaging.MessageDto> ?? Enumerable.Empty<AlMosafer.Application.DTOs.Messaging.MessageDto>();
    ViewData["Title"] = $"المحادثة مع {conversation?.OtherUserName}";
}

<a href="/Conversations" class="btn-ghost alm-back"><i class="alm-ic" data-lucide="arrow-right" aria-hidden="true"></i> رجوع إلى المحادثات</a>

<div class="row justify-content-center py-3">
    <div class="col-md-9 col-lg-8">
        <div class="card-almosafer shadow-lg border-0">
            <div class="card-header-custom p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 font-weight-bold">👤 @conversation?.OtherUserName (@conversation?.OtherUserRole)</h5>
                    <small class="text-light">مسار الرحلة: @conversation?.TripRoute</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">العودة للمحادثات</a>
            </div>

            <!-- Chat Messages Box -->
            <div class="card-body p-4 bg-light" id="messages-box" data-conversation-id="@Model.ConversationId" style="max-height: 450px; overflow-y: auto;">
                @if (!messages.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">لا توجد رسائل في هذه المحادثة حتى الآن. أرسل استفسارك للسائق/المسافر بخصوص الأمتعة أو موعد التجمع.</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in messages)
                    {
                        <div class="d-flex flex-column mb-3 @(msg.IsMine ? "align-items-start" : "align-items-end")">
                            <div class="p-3 rounded-lg shadow-sm style-msg @(msg.IsMine ? "bg-primary text-white" : "bg-white text-dark border")" style="max-width: 80%;">
                                <div class="font-weight-bold small mb-1">@msg.SenderName</div>
                                <!-- Safe Plain Text Render (XSS Defense) -->
                                <div class="text-break">@msg.Content</div>
                                <div class="text-start mt-1" style="font-size: 0.75rem; opacity: 0.85;">
                                    @msg.SentAt.ToString("HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Send Message Input Form -->
            <div class="card-footer p-3 bg-white border-top">
                <form asp-action="SendMessage" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ConversationId" />

                    <div class="col-9 col-md-10">
                        <input asp-for="Content" class="form-control form-control-custom" placeholder="اكتب رسالتك هنا..." autocomplete="off" autofocus />
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                    <div class="col-3 col-md-2">
                        <button type="submit" class="btn btn-accent w-100 font-weight-bold">إرسال 📤</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // الجلب الموحّد: يستبدل محتوى الصندوق بنسخة الخادم عند وجود جديد فقط (بحذر لا يمس كتابتك)
    (function () {
        var box = document.getElementById('messages-box');
        var input = document.querySelector('input[name="Content"]');
        if (!box) return;
        box.scrollTop = box.scrollHeight;

        var refresh = async function () {
            if (input && input.value.trim() !== '') return; // لا يُقاطع رسالة تُكتب الآن
            try {
                var res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'fetch-refresh' } });
                if (!res.ok) return;
                var html = await res.text();
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var fresh = doc.getElementById('messages-box');
                if (fresh && fresh.innerHTML !== box.innerHTML) {
                    box.innerHTML = fresh.innerHTML;
                    box.scrollTop = box.scrollHeight;
                }
            } catch (e) { /* أفضل جهد — لا يُقاطع المستخدم عند أي خلل شبكي */ }
        };

        // شبكة أمان: كل 15 ثانية — بحذر لا تعمل حين تخفي الصفحة
        setInterval(function () { if (!document.hidden) { refresh(); } }, 15000);

        // «النبض الحي» الموجة ٢: نبضة SignalR = تحديث فوري دون انتظار الدورة
        document.addEventListener('almosafer:chat-refresh', function () { refresh(); });

        // انضمام لمجموعة هذه المحادثة (الخادم يتحقق من العضوية — IDOR مرفوض)
        var joinConv = function () {
            if (window.__almConnection) {
                window.__almConnection.invoke('JoinConversation', Number(box.getAttribute('data-conversation-id')) || 0)
                    .catch(function () { });
            }
        };
        document.addEventListener('almosafer:realtime-join', joinConv);
        joinConv(); // قد يسبقنا الاتصال لجاهزيته إن كانت الصفحة أبطأ
    })();
</script>
