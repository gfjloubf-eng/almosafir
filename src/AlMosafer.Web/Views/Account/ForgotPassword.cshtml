@{
    ViewData["Title"] = "استعادة كلمة المرور";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card-almosafer shadow-lg border-0">
            <div class="card-header-custom text-center py-3 bg-primary">
                <h4 class="font-weight-bold mb-1">نسيت كلمة المرور؟ 🔑</h4>
                <small class="text-light">سنرسل لك رابط إعادة تعيين على بريدك الإلكتروني</small>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger"><div asp-validation-summary="All" class="mb-0"></div></div>
                }
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">البريد الإلكتروني المسجل</label>
                        <input type="email" name="email" class="form-control form-control-custom" placeholder="example@email.com" required autofocus />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 font-weight-bold">أرسل رابط الاستعادة 📧</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Login" class="text-decoration-none">العودة لتسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>
