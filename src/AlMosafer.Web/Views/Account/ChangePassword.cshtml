@model AlMosafer.Application.DTOs.Auth.ChangePasswordDto
@{
    ViewData["Title"] = "تغيير كلمة المرور — نظام المسافر";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card-almosafer shadow-lg border-0">
            <div class="card-header-custom p-4 text-center">
                <h4 class="font-weight-bold mb-1">تغيير كلمة المرور 🔑</h4>
                <small class="text-light">حافظ على أمان حسابك بتحديث كلمة المرور بانتظام</small>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label font-weight-bold">كلمة المرور الحالية *</label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" type="password" id="currentPassInput" class="form-control form-control-custom" autofocus />
                            <button type="button" class="btn btn-outline-secondary btn-toggle-password" data-target="currentPassInput" aria-label="إظهار كلمة المرور الحالية">👁️ إظهار</button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label font-weight-bold">كلمة المرور الجديدة *</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" id="newPassInput" class="form-control form-control-custom" placeholder="6 أحرف على الأقل" />
                            <button type="button" class="btn btn-outline-secondary btn-toggle-password" data-target="newPassInput" aria-label="إظهار كلمة المرور الجديدة">👁️ إظهار</button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label font-weight-bold">تأكيد كلمة المرور الجديدة *</label>
                        <div class="input-group">
                            <input asp-for="ConfirmNewPassword" type="password" id="confirmPassInput" class="form-control form-control-custom" />
                            <button type="button" class="btn btn-outline-secondary btn-toggle-password" data-target="confirmPassInput" aria-label="إظهار تأكيد كلمة المرور">👁️ إظهار</button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Profile" class="btn btn-outline-secondary font-weight-bold">إلغاء والعودة</a>
                        <button type="submit" class="btn btn-danger btn-lg font-weight-bold">حفظ كلمة المرور الجديدة 🔑</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
